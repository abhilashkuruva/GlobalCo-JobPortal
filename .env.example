# Database Connection
# Local MySQL:
# DB_URL=jdbc:mysql://localhost:3306/job_board_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Neon PostgreSQL (use the pooled -pooler host):
DB_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me

# Database Connection
# Local MySQL:
# DB_URL=jdbc:mysql://localhost:3306/job_board_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Neon PostgreSQL (use the pooled -pooler host):
DB_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me

# JWT Security Configuration
# Set a strong 256-bit secret key in production:
JWT_SECRET=v9y$B&E)H@McQfTjWnZr4u7x!A%C*F-JaNdRgUkXp2s5v8y/B?E(G+KbPeShVmYq
JWT_EXPIRATION=86400000

# Backend Server Port
SERVER_PORT=8080

# Production CORS (set to your Vercel URL after first deploy)
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

# Frontend (Vite) — used at build time on Vercel
VITE_API_BASE_URL=https://globalco-jobboard-backend.onrender.com/api

