# ==============================================================================
# GlobalCo JobBoard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or export these variables in your deployment environment.
# ==============================================================================

# Database Connection (Neon PostgreSQL in production)
DB_URL=jdbc:postgresql://your-neon-host/your_database?sslmode=require&prepareThreshold=0
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# JWT Security Configuration
# Set a strong 256-bit secret key in production:
JWT_SECRET=generate-a-random-256-bit-or-longer-secret
JWT_EXPIRATION=86400000

# Backend Server Port
SERVER_PORT=8080

# Production CORS and one-time initial admin bootstrap
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-strong-password
